<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="1330" viewBox="0 0 1080 1330" font-family="Microsoft YaHei, SimHei, sans-serif">
  <defs>
    <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#5a6b7d"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="1080" height="1330" fill="#ffffff"/>

  <!-- 标题 -->
  <text x="540" y="44" text-anchor="middle" font-size="26" font-weight="bold" fill="#2f3b47">药材热风干燥数学建模技术路线图</text>
  <text x="540" y="74" text-anchor="middle" font-size="14" fill="#6a7683">2026 年全国大学生数学建模竞赛 A 题</text>

  <!-- ============ 第 1 层：输入 ============ -->
  <!-- 输入参数 -->
  <rect x="60" y="105" width="460" height="130" rx="10" fill="#eef3f7" stroke="#8aa3b8" stroke-width="1.6"/>
  <rect x="60" y="105" width="460" height="34" rx="10" fill="#d7e3ec"/>
  <text x="290" y="128" text-anchor="middle" font-size="16" font-weight="bold" fill="#3d5a75">输入参数（题给条件）</text>
  <text x="80" y="162" font-size="13.5" fill="#33414e">几何：圆柱 L = 25 cm，R = 2 cm；初值 T₀ = 28 °C，C₀ = 2.55 kg/kg</text>
  <text x="80" y="186" font-size="13.5" fill="#33414e">物性：附录 2（常物性）/ 附录 3、4（ρ, c_p, k, D 经验式）</text>
  <text x="80" y="210" font-size="13.5" fill="#33414e">对流：h = 25 W/(m²·K)，h_m = 8×10⁻⁷ m/s；判据 C ≤ 0.15 kg/kg</text>

  <!-- 观测数据 -->
  <rect x="560" y="105" width="460" height="130" rx="10" fill="#eef3f7" stroke="#8aa3b8" stroke-width="1.6"/>
  <rect x="560" y="105" width="460" height="34" rx="10" fill="#d7e3ec"/>
  <text x="790" y="128" text-anchor="middle" font-size="16" font-weight="bold" fill="#3d5a75">观测数据（附件）</text>
  <text x="580" y="162" font-size="13.5" fill="#33414e">附件 1：烘房温度 T_a(t)、水分浓度 C_a(t)，0–14400 s</text>
  <text x="580" y="186" font-size="13.5" fill="#33414e">　　　　（t &gt; 14400 s 取末值恒温段 50.165 °C / 0.04986）</text>
  <text x="580" y="210" font-size="13.5" fill="#33414e">附件 2：药材半径 R(t)，0–72 h（Pchip 保形插值）</text>

  <!-- 箭头 1->2 -->
  <line x1="290" y1="235" x2="290" y2="270" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>
  <line x1="790" y1="235" x2="790" y2="270" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>

  <!-- ============ 第 2 层：四个模型模块 ============ -->
  <!-- 问题一 -->
  <rect x="30" y="272" width="240" height="200" rx="10" fill="#eaf4f0" stroke="#7fae9f" stroke-width="1.6"/>
  <rect x="30" y="272" width="240" height="34" rx="10" fill="#d3e8e0"/>
  <text x="150" y="295" text-anchor="middle" font-size="14.5" font-weight="bold" fill="#35604f">问题一　预热平衡模型</text>
  <text x="44" y="330" font-size="12" fill="#33414e">附录 2 常物性</text>
  <text x="44" y="353" font-size="12" fill="#33414e">D(C)=7×10⁻⁹e^(−0.89/C)</text>
  <text x="44" y="376" font-size="12" fill="#33414e">径向一维热传导+水分扩散</text>
  <text x="44" y="399" font-size="12" fill="#33414e">表面 Robin 边界条件</text>
  <text x="44" y="426" font-size="11.5" fill="#5b6a76">输出：表 1、2；result1.xlsx</text>
  <text x="44" y="450" font-size="11.5" fill="#35604f">Δr=0.03125 mm，Δt=0.125 s</text>

  <!-- 问题二 -->
  <rect x="290" y="272" width="240" height="200" rx="10" fill="#eaf4f0" stroke="#7fae9f" stroke-width="1.6"/>
  <rect x="290" y="272" width="240" height="34" rx="10" fill="#d3e8e0"/>
  <text x="410" y="295" text-anchor="middle" font-size="14.5" font-weight="bold" fill="#35604f">问题二　热质耦合模型</text>
  <text x="304" y="330" font-size="12" fill="#33414e">附录 3 变物性 ρ, c_p, k(C)</text>
  <text x="304" y="353" font-size="12" fill="#33414e">D(C,T) 含 Arrhenius 因子</text>
  <text x="304" y="376" font-size="12" fill="#33414e">双向弱耦合，交错 Picard</text>
  <text x="304" y="399" font-size="12" fill="#33414e">附件 1 烘房条件，解 0–3 h</text>
  <text x="304" y="426" font-size="11.5" fill="#5b6a76">输出：表 3、4；result2.xlsx</text>
  <text x="304" y="450" font-size="11.5" fill="#35604f">Δr=0.125 mm，Δt=0.25 s</text>

  <!-- 问题三 -->
  <rect x="550" y="272" width="240" height="200" rx="10" fill="#eaf4f0" stroke="#7fae9f" stroke-width="1.6"/>
  <rect x="550" y="272" width="240" height="34" rx="10" fill="#d3e8e0"/>
  <text x="670" y="295" text-anchor="middle" font-size="14.5" font-weight="bold" fill="#35604f">问题三　全程烘干模型</text>
  <text x="564" y="330" font-size="12" fill="#33414e">沿用问题二方程与物性</text>
  <text x="564" y="353" font-size="12" fill="#33414e">烘房条件两段拼接（附件 1</text>
  <text x="564" y="376" font-size="12" fill="#33414e">+ 恒温段末值），解至全程</text>
  <text x="564" y="399" font-size="12" fill="#33414e">判据 max C ≤ 0.15 kg/kg</text>
  <text x="564" y="426" font-size="11.5" fill="#5b6a76">输出：表 5；result3.xlsx</text>
  <text x="564" y="450" font-size="11.5" fill="#35604f">t*=57.1392 h（Δr=0.0625 mm）</text>

  <!-- 问题四 -->
  <rect x="810" y="272" width="240" height="200" rx="10" fill="#eaf4f0" stroke="#7fae9f" stroke-width="1.6"/>
  <rect x="810" y="272" width="240" height="34" rx="10" fill="#d3e8e0"/>
  <text x="930" y="294" text-anchor="middle" font-size="14" font-weight="bold" fill="#35604f">问题四　收缩动边界模型</text>
  <text x="824" y="330" font-size="12" fill="#33414e">附录 4 物性；附件 2 R(t)</text>
  <text x="824" y="353" font-size="12" fill="#33414e">随体坐标 ζ = r/R(t)</text>
  <text x="824" y="376" font-size="12" fill="#33414e">变换后无对流项、保持守恒</text>
  <text x="824" y="399" font-size="12" fill="#33414e">收缩使 D/R² 增大 2.8 倍</text>
  <text x="824" y="426" font-size="11.5" fill="#5b6a76">输出：表 6；result4.xlsx</text>
  <text x="824" y="450" font-size="11.5" fill="#35604f">t*=50.8049 h（Δζ=1/160）</text>

  <!-- 箭头 2->3 -->
  <line x1="150" y1="472" x2="150" y2="520" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>
  <line x1="410" y1="472" x2="410" y2="508" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>
  <line x1="670" y1="472" x2="670" y2="508" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>
  <line x1="930" y1="472" x2="930" y2="520" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>
  <line x1="150" y1="520" x2="930" y2="520" stroke="#5a6b7d" stroke-width="1.8"/>
  <line x1="540" y1="520" x2="540" y2="545" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>

  <!-- ============ 第 3 层：统一数值求解框架 ============ -->
  <rect x="120" y="547" width="840" height="150" rx="10" fill="#fdf3e7" stroke="#d9b184" stroke-width="1.6"/>
  <rect x="120" y="547" width="840" height="34" rx="10" fill="#f3e2c9"/>
  <text x="540" y="570" text-anchor="middle" font-size="16" font-weight="bold" fill="#7a5a2e">统一数值求解框架（四问共用）</text>
  <text x="160" y="608" font-size="13.5" fill="#33414e">空间：守恒型有限体积离散，表面节点位于真实表面，Robin 通量与内部界面通量逐层对消</text>
  <text x="160" y="632" font-size="13.5" fill="#33414e">时间：Crank–Nicolson 格式（无条件稳定、二阶），三对角方程组追赶法（Thomas）求解</text>
  <text x="160" y="656" font-size="13.5" fill="#33414e">非线性与双向耦合：交错 Picard 迭代（判据 10⁻⁸，实测平均 2.2–3.4 轮）</text>
  <text x="160" y="680" font-size="13.5" fill="#33414e">步长选取：网格减半 + Richardson 误差估计，数值误差低于四位小数末位之半</text>

  <!-- 箭头 3->4 -->
  <line x1="540" y1="697" x2="540" y2="735" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>

  <!-- ============ 第 4 层：模型检验 ============ -->
  <rect x="120" y="737" width="840" height="170" rx="10" fill="#f2eef6" stroke="#a99cc0" stroke-width="1.6"/>
  <rect x="120" y="737" width="840" height="34" rx="10" fill="#e2dcea"/>
  <text x="540" y="760" text-anchor="middle" font-size="16" font-weight="bold" fill="#574a72">模型检验（五重验证 + 灵敏度分析）</text>
  <text x="160" y="798" font-size="13.5" fill="#33414e">① 解析解对照：Bessel 级数解与数值解四位小数完全一致（问题一热传导）</text>
  <text x="160" y="822" font-size="13.5" fill="#33414e">② 收敛性：空间步长减半收敛比 4.0，验证二阶精度；t* 网格不确定度 ≤ 0.03 h</text>
  <text x="160" y="846" font-size="13.5" fill="#33414e">③ 离散质量守恒：闭合差 10⁻⁷ 以内（问题一达机器精度 10⁻¹⁸）</text>
  <text x="160" y="870" font-size="13.5" fill="#33414e">④ 渐近行为：长时程精确收敛至烘房参数；⑤ 活化能 32.0 kJ/mol 与文献互证</text>
  <text x="160" y="894" font-size="13.5" fill="#33414e">灵敏度：T_a ±2 °C → t* 变化 ∓6%~7%；h_m −50% → +13.3%（问题三）/+6.6%（问题四）</text>

  <!-- 箭头 4->5 -->
  <line x1="540" y1="907" x2="540" y2="945" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>

  <!-- ============ 第 5 层：核心结论 ============ -->
  <rect x="120" y="947" width="840" height="150" rx="10" fill="#fdeeee" stroke="#cf9a9a" stroke-width="1.6"/>
  <rect x="120" y="947" width="840" height="34" rx="10" fill="#f3d9d9"/>
  <text x="540" y="970" text-anchor="middle" font-size="16" font-weight="bold" fill="#7a3e3e">核心结论</text>
  <text x="160" y="1008" font-size="13.5" fill="#33414e">预热段：1800 s 时表面 36.79 °C / 1.51 kg/kg，水分变化集中于近表面约 5 mm 边界层</text>
  <text x="160" y="1032" font-size="13.5" fill="#33414e">烘干时长：问题三 t* = 57.14 ± 0.03 h（约 2.38 天）；问题四 t* = 50.80 ± 0.01 h（约 2.12 天）</text>
  <text x="160" y="1056" font-size="13.5" fill="#33414e">消融分析：收缩单独使时长缩短 56.0%–60.6%，附录 4 物性使其增加 126.0%，净缩短约 11%</text>
  <text x="160" y="1080" font-size="13.5" fill="#33414e">工艺启示：烘房温度为最敏感参数，恒温段温度控制是干燥工艺优化的核心</text>

  <!-- 箭头 5->6 -->
  <line x1="540" y1="1097" x2="540" y2="1135" stroke="#5a6b7d" stroke-width="1.8" marker-end="url(#arr)"/>

  <!-- ============ 第 6 层：评价与推广 ============ -->
  <rect x="120" y="1137" width="840" height="170" rx="10" fill="#eff1f3" stroke="#9aa5ad" stroke-width="1.6"/>
  <rect x="120" y="1137" width="840" height="34" rx="10" fill="#dde2e6"/>
  <text x="540" y="1160" text-anchor="middle" font-size="16" font-weight="bold" fill="#45525c">评价与推广</text>
  <text x="160" y="1198" font-size="13.5" fill="#33414e">优点：参数严格取自题给条件；离散通量严格闭合；验证体系完整；随体坐标处理简洁守恒</text>
  <text x="160" y="1222" font-size="13.5" fill="#33414e">不足：未显式计入汽化潜热（以 +40%~50% 时长敏感性区间保留）；径向一维与常对流系数简化</text>
  <text x="160" y="1246" font-size="13.5" fill="#33414e">推广：推广为中药材干燥工艺仿真工具，预测温度场、水分场与烘干时长</text>
  <text x="160" y="1270" font-size="13.5" fill="#33414e">　　　支撑工艺参数选取、能耗优化与分段变温策略的品质风险评估</text>

  <!-- 左侧分区标注 -->
  <text x="24" y="180" font-size="12" fill="#8aa3b8" transform="rotate(-90 24 180)" text-anchor="middle">输 入</text>
  <text x="24" y="372" font-size="12" fill="#7fae9f" transform="rotate(-90 24 372)" text-anchor="middle">建 模</text>
  <text x="90" y="622" font-size="12" fill="#d9b184" transform="rotate(-90 90 622)" text-anchor="middle">求 解</text>
  <text x="90" y="822" font-size="12" fill="#a99cc0" transform="rotate(-90 90 822)" text-anchor="middle">检 验</text>
  <text x="90" y="1022" font-size="12" fill="#cf9a9a" transform="rotate(-90 90 1022)" text-anchor="middle">结 论</text>
  <text x="90" y="1222" font-size="12" fill="#9aa5ad" transform="rotate(-90 90 1222)" text-anchor="middle">评 价</text>
</svg>
